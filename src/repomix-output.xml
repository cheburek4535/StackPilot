        {/each}
      </ul>
    </section>
  {:else}
    <p class="muted-note">{i18n.t("tc.profile.select_stack") as TranslationKey}</p>
  {/if}

  <!-- ===== Рекомендованные (честно пусто) ===== -->
  {#if profile.recommended.length > 0}
    <section aria-label={i18n.t("tc.profile.recommended") as TranslationKey}>
