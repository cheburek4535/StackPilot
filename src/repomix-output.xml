        <div class="skeleton-pill"></div>
        <div class="skeleton-pill"></div>
      </div>
      <div class="skeleton-builder">
        <div class="skeleton-phases">
          <div class="skeleton-phase"></div>
          <div class="skeleton-phase"></div>
          <div class="skeleton-phase"></div>
        </div>
