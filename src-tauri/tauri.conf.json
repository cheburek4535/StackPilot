{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackPilot",
  "version": "1.2.2",
  "identifier": "com.cheburek4535.stackpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "StackPilot",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 http://localhost:1420;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Niperc (cheburek4535)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
