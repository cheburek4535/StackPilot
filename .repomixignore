# =============================================================
#  Repomix filter for StackPilot devlauncher
#
#  This file lives in the project ROOT and is the single source
#  of truth for what repomix must skip.
#
#  compresser.bat copies it temporarily into every target
#  subfolder before packing a folder dump, then deletes the
#  copy right after repomix finishes.
# =============================================================

# ---- Pipeline scripts ----------------------------------------
clean.py
compresser.bat
compresser.ps1
rm-cleaner.bat
repomix_clean.bat
repomix_clean.ps1
dumper.bat
*.tmp

# ---- Repomix artifacts ----------------------------------------
repomix-output*.xml
repomix.log
repomix.config.json
repomix.config.jsonc
repomix.config.js
repomix.config.mjs
repomix.config.ts
.repomixignore

# ---- Build & dependency dirs (matched at any depth) -----------
node_modules/
dist/
build/
target/
.next/
.svelte-kit/
out/
coverage/

# ---- Editor / OS junk -----------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Lockfiles / bulk metadata (token economy) ----------------
package-lock.json
bun.lock
Cargo.lock