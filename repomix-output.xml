    \n                        for _ in 0..*timeout_secs {\n                            match TcpStream::connect_timeout(&addr, Duration::from_secs(2)) {\n                                Ok(mut stream) => {\n                                    // Исправлено: Строка запроса БЕЗ отступов слева и с макросом format!\n                                    let req = format!(\n\"GET / HTTP/1.1\\r\nHost: {}\\r\nConnection: close\\r\n\\r\\n\", formatted_url);\n\n                                    // Отправляем запрос. Если не ушло — игнорируем ошибку и идем на следующий круг\n                                    if stream.write_all(req.as_bytes()).is_err() {\n                                        thread::sleep(Duration::from_secs(1));\n                                        continue;\n                                    }\n\n                                    let mut reader = BufReader::new(&stream);\n                                    let mut response_line = String::new();\n\n                                    // Читаем ответ. Если не прочиталось — на следующий круг\n                                    if reader.read_line(&mut response_line).is_err() {\n                                        thread::sleep(Duration::from_secs(1));\n                                        continue;\n                                    }                  \n                                    \n                                    let split_resp_parts: Vec<&str> = response_line.split_whitespace().collect();\n                                    \n                                    // Исправлено: Безопасное извлечение статус-кода через .get(1)\n                                    if let Some(status_code) = split_resp_parts.get(1) {\n                                        // Проверяем, начинается ли статус с 2xx или 3xx\n                                        if status_code.starts_with('2') || status_code.starts_with('3') {\n                                            // Используем return, чтобы выйти из ВСЕЙ функции движка\n                                            return Ok(ActionStatus::Success { \n                                                message: format!(\"URL {} успешно ответил со статусом {}\", url, status_code)\n                                            });\n                                        } else {\n                                            println!(\"[LaunchEngine] Сервер {} вернул плохой статус: {}\", url, status_code);\n                                        }\n                                    }\n                                }\n                                Err(err) => {\n                                    println!(\"[LaunchEngine] Ошибка соединения с {}: {}. Повторяю...\", url, err);\n                                }\n                            }\n                            \n                            // Делаем паузу в 1 секунду между попытками подключения\n                            thread::sleep(Duration::from_secs(1));\n                        }\n                    }\n                }\n\n                // Если мы вывалились из цикла, значит время вышло, а сервер так и не ответил добром\n                Err(format!(\"Не удалось получить успешный ответ от {} за {} секунд\", url, timeout_secs))\n            }\n\n\n\n            ActionType::WaitForPort { host, port, timeout_secs } => {\n                println!(\"[LaunchEngine] Жду порт {}:{} ({}s)\", host, port, timeout_secs);\n\n                let addr_str = format!(\"{}:{}\", host, port);\n\n                if let Ok(mut addrs) = addr_str.to_socket_addrs() {\n                    if let Some(addr) = addrs.next() {\n\n                       for _ in 0..*timeout_secs {\n                        match TcpStream::connect_timeout(&addr,Duration::from_secs(1)) {\n                            Ok(_) => {\n                                return Ok(ActionStatus::Success { \n                            message: format!(\"Успех! Соединение установлено с {}:{}\", host, port)\n                        });\n                            }\n                            Err(_) => {\n                                println!(\"[LaunchEngine] Порт {}:{} еще не доступен, проверяю снова...\", host, port);\n\n                            }\n                        }\n                        }\n                    }\n                }\n                Err(format!(\"Не удалось подключиться к порту {}:{} после {} секунд ожидания\", host, port, timeout_secs))\n        \n            }\n            ActionType::Delay { seconds } => {\n                println!(\"[LaunchEngine] Пауза {}s\", seconds);\n                let dur = Duration::from_secs(*seconds);\n                thread::sleep(dur);\n                Ok(ActionStatus::Success {\n                    message: format!(\"Пауза {} секунд\", seconds),\n                })\n            }\n            ActionType::ExecuteScript { script, shell } => {\n                println!(\"[LaunchEngine] Скрипт: '{}' через {:?}\", script, shell);\n                let shell_name = shell.as_deref().unwrap_or(\"cmd\");\n                let flag = match shell_name {\n                    \"cmd\" => \"/C\",\n                    \"powershell\" | \"pwsh\" => \"-Command\",\n                    _ => \"-c\",\n                };\n\n                let mut command = Command::new(shell_name);\n                command.args([flag, script]);\n\n\n                match command.status() {\n                    Ok(exit_status) => {\n                        if exit_status.success() {\n                          Ok(ActionStatus::Success {\n                                message: format!(\"Скрипт успешно выполнен через {}: {}\", shell_name, script),\n                            })  \n                        } else {\n                            let code = exit_status.code().unwrap_or(-1);\n                            Ok(ActionStatus::Failed { \n                                error: format!(\"Скрипт завершился с ошибкой (код: {})\", co