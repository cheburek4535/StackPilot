              "file": "src-tauri/src/process_manager.rs",
              "patch": "Index: src-tauri/src/process_manager.rs\n===================================================================\n--- src-tauri/src/process_manager.rs\t\n+++ src-tauri/src/process_manager.rs\t\n@@ -1,209 +0,0 @@\n-// ============================================================\n-// ProcessManager — отслеживание запущенных процессов.\n-//\n-// Хранит все запущенные через DevLauncher процессы,\n-// позволяет проверить их статус, убить, перезапустить.\n-//\n-// # Архитектура\n-//\n-// ProcessManager — трейт. Реализация OsProcessManager\n-// использует std::process::Child + Arc<Mutex<HashMap>>.\n-//\n-// Важный нюанс: Child не реализует Send.\n-// Решение: храним Option<Child>, забираем только когда\n-// нужно проверить статус (try_wait) или убить.\n-// ============================================================\n-\n-use serde::{Deserialize, Serialize};\n-use std::collections::HashMap;\n-use std::process::{Child, Command, Stdio};\n-use std::sync::{Arc, Mutex};\n-use std::time::{SystemTime, UNIX_EPOCH};\n-\n-// --------------------------------------------------\n-// TrackedProcess — публичная информация о процессе\n-// --------------------------------------------------\n-#[derive(Debug, Clone, Serialize, Deserialize)]\n-pub struct TrackedProcess {\n-    pub id: String,\n-    pub pid: u32,\n-    pub label: String,\n-    pub status: ProcessStatus,\n-    pub started_at: String,\n-}\n-\n-// --------------------------------------------------\n-// ProcessStatus — статус процесса\n-// --------------------------------------------------\n-#[derive(Debug, Clone, Serialize, Deserialize)]\n-pub enum ProcessStatus {\n-    Running,\n-    Exited(i32),\n-    Killed,\n-    Crashed,\n-}\n-\n-// --------------------------------------------------\n-// ActiveProcess — внутреннее хранение (с Child)\n-// --------------------------------------------------\n-struct ActiveProcess {\n-    info: TrackedProcess,\n-    child: Option<Child>,\n-}\n-\n-// --------------------------------------------------\n-// Трейт ProcessManager\n-// --------------------------------------------------\n-pub trait ProcessManager: Send + Sync {\n-    /// Запустить процесс и начать отслеживание\n-    fn spawn_and_track(\n-        &self,\n-        command: &str,\n-        args: &[String],\n-        working_dir: Option<&str>,\n-        label: &str,\n-    ) -> Result<TrackedProcess, String>;\n-\n-    /// Список всех отслеживаемых процессов\n-    fn list(&self) -> Vec<TrackedProcess>;\n-\n-    /// Убить процесс по ID\n-    fn kill(&self, id: &str) -> Result<(), String>;\n-\n-    /// Обновить статус процесса (проверить, жив ли)\n-    fn refresh_status(&self, id: &str) -> Result<ProcessStatus, String>;\n-}\n-\n-// --------------------------------------------------\n-// OsProcessManager — реализация\n-// --------------------------------------------------\n-pub struct OsProcessManager {\n-    processes: Arc<Mutex<HashMap<String, ActiveProcess>>>,\n-}\n-\n-impl OsProcessManager {\n-    pub fn new() -> Self {\n-        Self {\n-            processes: Arc::new(Mutex::new(HashMap::new())),\n-        }\n-    }\n-}\n-\n-impl ProcessManager for OsProcessManager {\n-    fn spawn_and_track(\n-        &self,\n-        command: &str,\n-        args: &[String],\n-        working_dir: Option<&str>,\n-        label: &str,\n-    ) -> Result<TrackedProcess, String> {\n-        let mut cmd = Command::new(\"cmd\");\n-        cmd.arg(\"/C\")\n-            .arg(command)\n-            .args(args)\n-            .stdout(Stdio::null())\n-            .stderr(Stdio::null());\n-\n-        if let Some(dir) = working_dir {\n-            cmd.current_dir(dir);\n-        }\n-\n-        let child = cmd.spawn().map_err(|e| format!(\"Ошибка запуска: {}\", e))?;\n-        let pid = child.id();\n-        let id = generate_id();\n-        let started_at = timestamp_now();\n-\n-        let info = TrackedProcess {\n-            id: id.clone(),\n-            pid,\n-            label: label.to_string(),\n-            status: ProcessStatus::Running,\n-            started_at,\n-        };\n-\n-        let entry = ActiveProcess {\n-            info: info.clone(),\n-            child: Some(child),\n-        };\n-\n-        self.processes\n-            .lock()\n-            .expect(\"processes lock poisoned\")\n-            .insert(id, entry);\n-\n-        Ok(info)\n-    }\n-\n-    fn list(&self) -> Vec<TrackedProcess> {\n-        let lock = self.processes.lock().expect(\"processes lock poisoned\");\n-        lock.values().map(|p| p.info.clone()).collect()\n-    }\n-\n-    fn kill(&self, id: &str) -> Result<(), String> {\n-        let mut lock = self.processes.lock().expect(\"processes lock poisoned\");\n-\n-        let entry = lock\n-            .get_mut(id)\n-            .ok_or_else(|| format!(\"Процесс с id {} не найден\", id))?;\n-\n-        let pid = entry.info.pid;\n-\n-        // На Windows убиваем через taskkill\n-        let _ = Command::new(\"taskkill\")\n-            .args([\"/F\", \"/PID\", &pid.to_string()])\n-            .status();\n-\n-        entry.child = None;\n-        entry.info.status = ProcessStatus::Killed;\n-\n-        Ok(())\n-    }\n-\n-    fn refresh_status(&self, id: &str) -> Result<ProcessStatus, String> {\n-        let mut lock = self.processes.lock().expect(\"processes lock poisoned\");\n-\n-        let entry = lock\n-            .get_mut(id)\n-            .ok_or_else(|| format!(\"Процесс с id {} не найден\", id))?;\n-\n-        if let Some(ref mut child) = entry.child {\n-            match child.try_wait() {\n-                Ok(None) => {\n-                    // Всё ещё работает\n-                    entry.info.status = ProcessStatus::Running;\n-                    Ok(ProcessStatus::Running)\n-                }\n-                Ok(Some(status)) => {\n-                    entry.child = None;\n-                    let new_status = if status.success() {\n-                        ProcessStatus::Exited(status.code().unwrap_or(0))\n-                    } else {\n-                        ProcessStatus::Crashed\n-                    };\n-                    entry.info.status = new_status.clone();\n-                    Ok(new_status)\n-                }\n-                Err(e) => Err(format!(\"Ошибка try_wait: {}\", e)),\n-            }\n-        } else {\n-            // Процесс уже завершён, возвращаем последний известный статус\n-            Ok(entry.info.status.clone())\n-        }\n-    }\n-}\n-\n-fn generate_id() -> String {\n-    let nanos = SystemTime::now()\n-        .duration_since(UNIX_EPOCH)\n-        .unwrap_or_default()\n-        .as_nanos();\n-    format!(\"proc_{}\", nanos)\n-}\n-\n-fn timestamp_now() -> String {\n-    let dur = SystemTime::now()\n-        .duration_since(UNIX_EPOCH)\n-        .unwrap_or_default();\n-    // Unix timestamp в секундах. Фронтенд отформатирует как нужно.\n-    dur.as_secs().to_string()\n-}\n",
              "additions": 0,
              "deletions": 209,
              "status": "deleted"
            },
