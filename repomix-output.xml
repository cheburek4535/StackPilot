                </div>
                <div class="proc-meta">
                  PID <code>{p.pid}</code>
                  <span class="sep">·</span>
                  {formatDuration(p.duration_secs)}
                  <span class="sep">·</span>
                  started {((Date.now() / 1000) - Number(p.started_at)).toFixed(0)}s ago
