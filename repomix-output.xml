е ====================\n60: \n61:   async function handleSave() {\n62:     if (!profile) return;\n63:     saving = true;\n64:     error = \"\";\n65:     savedOk = false;\n66:     try {\n67:       await saveProfile(profile);\n68:       savedOk = true;\n69:     } catch (e) {\n70:       error = `Ошибка сохранения: ${e}`;\n71:     }\n72:     saving = false;\n73:   }\n74: \n75:   // ==================== Drag & Drop ====================\n76: \n77:   function onDragStart(e: DragEvent, index: number) {\n78:     dragIndex = index;\n79:     if (e.dataTransfer) {\n80:       e.dataTransfer.effectAllowed = \"move\";\n81:     }\n82:   }\n83: \n84:   function onDragOver(e: DragEvent, index: number) {\n85:     e.preventDefault();\n86:     if (e.dataTransfer) e.dataTransfer.dropEffect = \"move\";\n87:     dragOverIndex = index;\n88:   }\n89: \n90:   function onDragLeave() {\n91:     dragOverIndex = null;\n92:   }\n93: \n94:   function onDrop(index: number) {\n95:     if (dragIndex === null || dragIndex === index || !profile) return;\n96:     const actions = [...profile.actions];\n97:     const [moved] = actions.splice(dragIndex, 1);\n98:     actions.splice(index, 0, moved);\n99:     profile = { ...profile, actions };\n100:     dragIndex = null;\n101:     dragOverIndex = null;\n102:   }\n103: \n104:   function onDragEnd() {\n105:     dragIndex = null;\n106:     dragOverIndex = null;\n107:   }\n108: \n109:   // ==================== Управление действиями ====================\n110: \n111:   function toggleExpand(id: string) {\n112:     const next = new Set(expanded);\n113:     if (next.has(id)) next.delete(id);\n114:     else next.add(id);\n115:     expanded = next;\n116:   }\n117: \n118:   function removeAction(index: number) {\n119:     if (!profile) return;\n120:     const actions = profile.actions.filter((_, i) => i !== index);\n121:     profile = { ...profile, actions };\n122:   }\n123: \n124:   function toggleEnabled(index: number) {\n125:     if (!profile) return;\n126:     const actions = profile.actions.map((a, i) =>\n127:       i === index ? { ...a, enabled: !a.enabled } : a,\n128:     );\n129:     profile = { ...profile, actions };\n130:   }\n131: \n132:   function updateLabel(index: number, label: string) {\n133:     if (!profile) return;\n134:     const actions = profile.actions.map((a, i) =>\n135:       i === index ? { ...a, label } : a,\n136:     );\n137:     profile = { ...profile, actions };\n138:   }\n139: \n140:   // ==================== Редактирование параметров действия ====================\n141: \n142:   function updateActionField(index: number, path: string[], value: unknown) {\n143:     if (!profile) return;\n144:     const actions = profile.actions.map((a, i) => {\n145:       if (i !== index) return a;\n146:       return setNestedField(a, path, value);\n147:     });\n148:     profile = { ...profile, actions };\n149:   }\n150: \n151:   function setNestedField(obj: unknown, path: string[], value: unknown): unknown {\n152:     if (path.length === 0) return value;\n153:     const [first, ...rest] = path;\n154:     if (typeof obj === \"object\" && obj !== null && !Array.isArray(obj)) {\n155:       const record = obj as Record<string, unknown>;\n156:       if (first === \"action_type\" && rest.length > 0) {\n157:         // Special handling for discriminated union action_type\n158:         const currentType = record.action_type as Record<string, unknown>;\n159:         const variantKey = Object.keys(currentType)[0];\n160:         if (rest.length === 1 && rest[0] === variantKey) {\n161:           // Replacing the variant field entirely\n162:           const nested = setNestedField(currentType[variantKey], [], value);\n163:           return { ...record, action_type: { [variantKey]: nested } };\n164:         }\n165:         if (rest[0] === variantKey) {\n166:           const nested = setNestedField(currentType[variantKey], rest.slice(1), value);\n167:           return { ...record, action_type: { [variantKey]: nested } };\n168:         }\n169:         if (rest[0] !== variantKey) {\n170:           return record; // ignore mismatched path\n171:         }\n172:       }\n173:       return { ...record, [first]: setNestedField(record[first], rest, value) };\n174:     }\n175:     if (Array.isArray(obj)) {\n176:       const idx = Number(first);\n177:       const arr = [...obj];\n178:       arr[idx] = setNestedField(arr[idx], rest, value);\n179:       return arr;\n180:     }\n181:     return obj;\n182:   }\n183: \n184:   function changeActionType(index: number, newType: string) {\n185:     if (!profile) return;\n186:     const actions = profile.actions.map((a, i) => {\n187:       if (i !== index) return a;\n188:       let action_type: ActionType;\n189:       switch (newType) {\n190:         case \"RunCommand\":\n191:           action_type = { RunCommand: { command: \"\", working_dir: projectPath || null } };\n192:           break;\n193:         case \"OpenUrl\":\n194:           action_type = { OpenUrl: { url: \"\" } };\n195:           break;\n196:         case \"OpenApplication\":\n197:           action_type = { OpenApplication: { path: \"\", args: null } };\n198:           break;\n199:         case \"WaitForUrl\":\n200:           action_type = { WaitForUrl: { url: \"\", timeout_secs: 30 } };\n201:           break;\n202:         case \"WaitForPort\":\n203:           action_type = { WaitForPort: { host: \"localhost\", port: 3000, timeout_secs: 30 } };\n204:           break;\n205:         case \"Delay\":\n206:           action_type = { Delay: { seconds: 5 } };\n207:           break;\n208:         case \"ExecuteScript\":\n209:           action_type = { ExecuteScript: { script: \"\", shell: \"cmd\" } };\n210:           break;\n211:         default:\n212:           return a;\n213:       }\n214:       return { ...a, action_type };\n215:     });\n216:     profile = { ...profile, actions };\n217:   }\n218: \n219:   function createActionWithType(type: string, projectPath: string): LaunchAction {\n220:     let action_type: ActionType;\n221:     switch (type) {\n222:       case \"RunCommand\":\n223:         action_type = { RunCommand: { command: \"\", working_dir: projectPath || null } };\n224:         break;\n225:       case \"OpenUrl\":\n226:         action_type = { OpenUrl: { url: \"\" } };\n227:         break;\n228:       case \"OpenApplication\":\n229:         action_type = { OpenApplication: { path: \"\", args: null } };\n230:         break;\n231:       case \"WaitForUrl\":\n232:         action_type = { WaitForUrl: { url: \"\", timeout_secs: 30 } };\n233:         break;\n234:       case \"WaitForPort\":\n235:         action_type = { WaitForPort: { host: \"localhost\", port: 3000, timeout_secs: 30 } };\n236:         break;\n237:       case \"Delay\":\n238:         action_type = { Delay: { seconds: 5 } };\n239:         break;\n240:       case \"ExecuteScript\":\n241:         action_type = { ExecuteScript: { script: \"\", shell: \"cmd\" } };\n242:         break;\n243:       default:\n244:         action_type = { RunCommand: { command: \"\", working_dir: projectPath || null } };\n245:     }\n246:     return {\n247:       id: `act_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n248:       label: \"Новое действие\",\n249:       enabled: true,\n250:       action_type,\n251:     };\n252:   }\n253: \n254:   function addAction(actionType: string) {\n255:     if (!profile) return;\n256:     showAddMenu = false;\n257:     const newAction = createActionWithType(actionType, projectPath);\n258:     profile = { ...profile, actions: [...profile.actions, newAction] };\n259:     const next = new Set(expanded);\n260:     next.add(newAction.id);\n261:     expanded = next;\n262:   }\n263: \n264:   // ==================== Вспомогательные функции ====================\n265: \n266:   function actionIcon(act: ActionType): string {\n267:     if (\"RunCommand\" in act) return \"▶\";\n268:     if (\"OpenUrl\" in act) return \"🌐\";\n269:     if (\"OpenApplication\" in act) return \"⬛\";\n270:     if (\"WaitForUrl\" in act) return \"⏳\";\n271:     if (\"WaitForPort\" in act) return \"🔌\";\n272:     if (\"Delay\" in act) return \"⏱\";\n273:     if (\"ExecuteScript\" in act) return \"📜\";\n274:     return \"?\";\n275:   }\n276: \n277:   function actionTypeName(act: ActionType): string {\n278:     if (\"RunCommand\" in act) return \"Команда\";\n279:     if (\"OpenUrl\" in act) return \"URL\";\n280:     if (\"OpenApplication\" in act) return \"Приложение\";\n281:     if (\"WaitForUrl\" in act) return \"Ожидание URL\";\n282:     if (\"WaitForPort\" in act) return \"Ожидание порта\";\n283:     if (\"Delay\" in act) return \"Пауза\";\n284:     if (\"ExecuteScript\" in act) return \"Скрипт\";\n285:     return \"?\";\n286:   }\n287: \n288:   function actionSummary(act: ActionType): string {\n289:     if (\"RunCommand\" in act) return act.RunCommand.command || \"(пусто)\";\n290:     if (\"OpenUrl\" in act) return act.OpenUrl.url || \"(пусто)\";\n291:     if (\"OpenApplication\" in act) return act.OpenApplication.path || \"(пусто)\";\n292:     if (\"WaitForUrl\" in act) return act.WaitForUrl.url || \"(пусто)\";\n293:     if (\"WaitForPort\" in act) return `${act.WaitForPort.host}:${act.WaitForPort.port}`;\n294:     if (\"Delay\" in act) return `${act.Delay.seconds}с`;\n295:     if (\"ExecuteScript\" in act) return act.ExecuteScript.script || \"(пусто)\";\n296:     return \"?\";\n297:   }\n298: \n299:   function actionVariant(act: ActionType): string {\n300:     return Object.keys(act)[0];\n301:   }\n302: \n303:   function variantValue(act: ActionType): Record<string, unknown> {\n304:     const key = actionVariant(act);\n305:     return (act as Record<string, unknown>)[key] as Record<string, unknown>;\n306:   }\n307: \n308:   // Типы действий для выпадающего меню\n309:   const actionTypes = [\n310:     { key: \"RunCommand\", icon: \"▶\", label: \"Команда\", desc: \"Запустить команду в терминале\" },\n311:     { key: \"OpenUrl\", icon: \"🌐\", label: \"URL\", desc: \"Открыть веб-страницу\" },\n312:     { key: \"OpenApplication\", icon: \"⬛\", label: \"Приложение\", desc: \"Запустить приложение\" },\n313:     { key: \"WaitForUrl\", icon: \"⏳\", label: \"Ожидание URL\", desc: \"Ждать пока URL ответит\" },\n314:     { key: \"WaitForPort\", icon: \"🔌\", label: \"Ожидание порта\", desc: \"Ждать TCP порт\" },\n315:     { key: \"Delay\", icon: \"⏱\", label: \"Пауза\", desc: \"Подождать N секунд\" },\n316:     { key: \"ExecuteScript\", icon: \"📜\", label: \"Скрипт\", desc: \"Выполнить скрипт\" },\n317:   ];\n318: \n319:   // ==================== Поля редактора для каждого типа действия ====================\n320:   function getEditorFields(act: ActionType): Array<{ label: string; path: string[]; type: string; value: unknown; placeholder: string }> {\n321:     const key = Object.keys(act)[0];\n322:     const val = (act as Record<string, unknown>)[key] as Record<string, unknown>;\n323: \n324:     switch (key) {\n325:       case \"RunCommand\": {\n326:         const v = val as { command: string; working_dir: string | null };\n327:         return [\n328:           { label: \"Команда\", path: [\"action_type\", \"RunCommand\", \"command\"], type: \"text\", value: v.command ?? \"\", placeholder: \"npm run dev\" },\n329:           { label: \"Рабочая папка\", path: [\"action_type\", \"RunCommand\", \"working_dir\"], type: \"text\", value: v.working_dir ?? \"\", placeholder: \"оставить пустым для корня проекта\" },\n330:         ];\n331:       }\n332:       case \"OpenUrl\": {\n333:         const v = val as { url: string };\n334:         return [\n335:           { label: \"URL\", path: [\"action_type\", \"OpenUrl\", \"url\"], type: \"text\", value: v.url ?? \"\", placeholder: \"http://localhost:3000\" },\n336:         ];\n337:       }\n338:       case \"OpenApplication\": {\n339:         const v = val as { path: string; args: string | null };\n340:         return [\n341:           { label: \"Путь к приложению\", path: [\"action_type\", \"OpenApplication\", \"path\"], type: \"text\", value: v.path ?? \"\", placeholder: \"code\" },\n342:           { label: \"Аргументы\", path: [\"action_type\", \"OpenApplication\", \"args\"], type: \"text\", value: v.args ?? \"\", placeholder: \".\" },\n343:         ];\n344:       }\n345:       case \"WaitForUrl\": {\n346:         const v = val as { url: string; timeout_secs: number };\n347:         return [\n348:           { label: \"URL\", path: [\"action_type\", \"WaitForUrl\", \"url\"], type: \"text\", value: v.url ?? \"\", placeholder: \"http://localhost:3000/health\" },\n349:           { label: \"Таймаут (сек)\", path: [\"action_type\", \"WaitForUrl\", \"timeout_secs\"], type: \"number\", value: v.timeout_secs, placeholder: \"30\" },\n350:         ];\n351:       }\n352:       case \"WaitForPort\": {\n353:         const v = val as { host: string; port: number; timeout_secs: number };\n354:         return [\n355:           { label: \"Хост\", path: [\"action_type\", \"WaitForPort\", \"host\"], type: \"text\", value: v.host ?? \"\", placeholder: \"localhost\" },\n356:           { label: \"Порт\", path: [\"action_type\", \"WaitForPort\", \"port\"], type: \"number\", value: v.port, placeholder: \"3000\" },\n357:           { label: \"Таймаут (сек)\", path: [\"action_type\", \"WaitForPort\", \"timeout_secs\"], type: \"number\", value: v.timeout_secs, placeholder: \"30\" },\n358:         ];\n359:       }\n360:       case \"Delay\": {\n361:         const v = val as { seconds: number };\n362:         return [\n363:           { label: \"Секунд\", path: [\"action_type\", \"Delay\", \"seconds\"], type: \"number\", value: v.seconds, placeholder: \"5\" },\n364:         ];\n365:       }\n366:       case \"ExecuteScript\": {\n367:         const v = val as { script: string; shell: string | null };\n368:         return [\n369:           { label: \"Скрипт\", path: [\"action_type\", \"ExecuteScript\", \"script\"], type: \"textarea\", value: v.script ?? \"\", placeholder: \"echo Hello\" },\n370:           { label: \"Оболочка\", path: [\"action_type\", \"ExecuteScript\", \"shell\"], type: \"text\", value: v.shell ?? \"cmd\", placeholder: \"cmd\" },\n371:         ];\n372:       }\n373:       default:\n374:         return [];\n375:     }\n376:   }\n377: </script>\n378: \n379: <main>\n380:   <h1>📊 Анализ проекта</h1>\n381:   <p class=\"subtitle\">Выберите папку с проектом — DevLauncher проанализирует структуру и предложит готовый профиль запуска</p>\n382: \n383:   <!-- Панель выбора папки -->\n384:   <div class=\"picker-card\">\n385:     <div class=\"picker-row\">\n386:       <button class=\"primary\" onclick={pickFolder}>📁 Выбрать папку</button>\n387:       {#if projectPath}\n388:         <span class=\"path-display\">{projectPath}</span>\n389:         <button class=\"secondary\" onclick={handleAnalyze} disabled={loading}>\n390:           {loading ? \"Анализирую...\" : \"🔍 Анализировать\"}\n391:         </button>\n392:       {/if}\n393:     </div>\n394:     {#if !projectPath}\n395:       <p class=\"hint\">Нажмите «Выбрать папку», затем «Анализировать»</p>\n396:     {/if}\n397: \n398:     {#if error}\n399:       <div class=\"msg error\">{error}</div>\n400:     {/if}\n401: \n402:     {#if savedOk}\n403:       <div class=\"msg success\">\n404:         ✅ Профиль сохранён!\n405:         <button class=\"link\" onclick={() => goto(\"/profiles\")}>Перейти к профилям →</button>\n406:       </div>\n407:     {/if}\n408:   </div>\n409: \n410:   <!-- Результат анализа + редактор -->\n411:   {#if profile}\n412:     <section class=\"editor\">\n413:       <div class=\"editor-header\">\n414:         <div>\n415:           <h2>📦 {profile.name}</h2>\n416:           <p class=\"desc\">{profile.description}</p>\n417:         </div>\n418:         <button class=\"primary save-btn\" onclick={handleSave} disabled={saving}>\n419:           {saving ? \"Сохранение...\" : \"💾 Сохранить профиль\"}\n420:         </button>\n421:       </div>\n422: \n423:       <!-- Список действий (интерактивный) -->\n424:       <div class=\"action-list\" role=\"list\">\n425:         {#each profile.actions as action, i (action.id)}\n426:           <div\n427:             class=\"action-card\"\n428:             class:expanded={expanded.has(action.id)}\n429:             class:disabled={!action.enabled}\n430:             class:drag-over={dragOverIndex === i}\n431:             draggable=\"true\"\n432:             ondragstart={(e) => onDragStart(e, i)}\n433:             ondragover={(e) => onDragOver(e, i)}\n434:             ondragleave={onDragLeave}\n435:             ondrop={(e) => { e.preventDefault(); onDrop(i); }}\n436:             ondragend={onDragEnd}\n437:           >\n438:             <!-- Верхняя строка (всегда видна) -->\n439:             <div class=\"card-header\">\n440:               <span class=\"drag-handle\" title=\"Перетащить чтобы изменить порядок\">⠿</span>\n441:               <span class=\"card-icon\">{actionIcon(action.action_type)}</span>\n442:               <div class=\"card-info\" onclick={() => toggleExpand(action.id)} role=\"button\" tabindex=\"0\" onkeydown={(e) => e.key === \"Enter\" && toggleExpand(action.id)}>\n443:                 <span class=\"card-label\">{action.label || \"(без названия)\"}</span>\n444:                 <span class=\"card-type\">{actionTypeName(action.action_type)}</span>\n445:                 <span class=\"card-summary\">{actionSummary(action.action_type)}</span>\n446:               </div>\n447:               <div class=\"card-controls\">\n448:                 <button\n449:                   class=\"toggle-btn\"\n450:                   class:on={action.enabled}\n451:                   onclick={() => toggleEnabled(i)}\n452:                   title={action.enabled ? \"Выключить\" : \"Включить\"}\n453:                 >\n454:                   {action.enabled ? \"ON\" : \"OFF\"}\n455:                 </button>\n456:                 <button class=\"icon-btn\" onclick={() => removeAction(i)} title=\"Удалить\">✕</button>\n457:                 <button\n458:                   class=\"icon-btn expand-btn\"\n459:                   onclick={() => toggleExpand(action.id)}\n460:                   title=\"Редактировать\"\n461:                 >\n462:                   {expanded.has(action.id) ? \"▲\" : \"▼\"}\n463:                 </button>\n464:               </div>\n465:             </div>\n466: \n467:             <!-- Расширенный редактор (открывается по клику) -->\n468:             {#if expanded.has(action.id)}\n469:               <div class=\"card-editor\">\n470:                 <div class=\"field\">\n471:                   <label>Название</label>\n472:                   <input\n473:                     type=\"text\"\n474:                     value={action.label}\n475:                     oninput={(e) => updateLabel(i, (e.target as HTMLInputElement).value)}\n476:                     placeholder=\"Краткое описание действия\"\n477:                   />\n478:                 </div>\n479:                 <div class=\"field\">\n480:                   <label>Тип действия</label>\n481:                   <select\n482:                     value={actionVariant(action.action_type)}\n483:                     onchange={(e) => changeActionType(i, (e.target as HTMLSelectElement).value)}\n484:                   >\n485:                     {#each actionTypes as at}\n486:                       <option value={at.key}>{at.icon} {at.label}</option>\n487:                     {/each}\n488:                   </select>\n489:                 </div>\n490: \n491:                 <!-- Поля в зависимости от типа -->\n492:                 {#each getEditorFields(action.action_type) as field}\n493:                   <div class=\"field\">\n494:                     <label>{field.label}</label>\n495:                     {#if field.type === \"number\"}\n496:                       <input\n497:                         type=\"number\"\n498:                         value={field.value as number}\n499:                         oninput={(e) => {\n500:                           const val = parseInt((e.target as HTMLInputElement).value) || 0;\n501:                           updateActionField(i, field.path, val);\n502:                         }}\n503:                         placeholder={field.placeholder}\n504:                       />\n505:                     {:else if field.type === \"textarea\"}\n506:                       <textarea\n507:                         value={field.value as string}\n508:                         oninput={(e) => {\n509:                           updateActionField(i, field.path, (e.target as HTMLTextAreaElement).value);\n510:                         }}\n511:                         placeholder={field.placeholder}\n512:                       ></textarea>\n513:                     {:else}\n514:                       <input\n515:                         type=\"text\"\n516:                         value={field.value as string}\n517:                         oninput={(e) => {\n518:                           updateActionField(i, field.path, (e.target as HTMLInputElement).value);\n519:                         }}\n520:                         placeholder={field.placeholder}\n521:                       />\n522:                     {/if}\n523:                   </div>\n524:                 {/each}\n525:               </div>\n526:             {/if}\n527:           </div>\n528:         {/each}\n529:       </div>\n530: \n531:       <!-- Кнопка \"Добавить действие\" -->\n532:       <div class=\"add-wrapper\">\n533:         <button class=\"secondary add-btn\" onclick={() => (showAddMenu = !showAddMenu)}>\n534:           + Добавить действие\n535:         </button>\n536:         {#if showAddMenu}\n537:           <div class=\"add-menu\">\n538:             {#each actionTypes as at}\n539:               <button class=\"add-menu-item\" onclick={() => addAction(at.key)}>\n540:                 <span class=\"add-icon\">{at.icon}</span>\n541:                 <div>\n542:                   <strong>{at.