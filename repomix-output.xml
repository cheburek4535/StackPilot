333;\n     }\n \n     button.icon-btn {\n       color: #888;\n       border-color: #555;\n     }\n \n     button.icon-btn:hover:not(:disabled) {\n       background: #333;\n       color: #ef9a9a;\n       border-color: #ef9a9a;\n     }\n   }\n </style>\n",
