              "content": "<script lang=\"ts\">\n  import { open } from \"@tauri-apps/plugin-dialog\";\n  import { analyzeProject, saveProfile, getSettings } from \"$lib/api\";\n  import { goto } from \"$app/navigation\";\n  import type { LaunchProfile, LaunchAction, ActionType } from \"$lib/types\";\n\n  // ==================== Состояние ====================\n\n  let projectPath = $state(\"\");\n  let profile = $state<LaunchProfile | null>(null);\n  let loading = $state(false);\n  let saving = $state(false);\n  let error = $state(\"\");\n  let savedOk = $state(false);\n\n  // Для drag & drop\n  let dragIndex = $state<number | null>(null);\n  let dragOverIndex = $state<number | null>(null);\n\n  // Какие карточки развёрнуты для редактирования\n  let expanded = $state(new Set<string>());\n\n  // Меню добавления действий\n  let showAddMenu = $state(false);\n\n  // ==================== Выбор папки ====================\n\n  async function pickFolder() {\n    const selected = await open({\n      directory: true,\n      multiple: false,\n      title: \"Выберите папку проекта\",\n    });\n    if (selected) {\n      projectPath = selected;\n      profile = null;\n      error = \"\";\n      savedOk = false;\n    }\n  }\n\n  // ==================== Анализ ====================\n\n  async function handleAnalyze() {\n    if (!projectPath) return;\n    loading = true;\n    error = \"\";\n    savedOk = false;\n    profile = null;\n    expanded = new Set();\n    try {\n      profile = await analyzeProject(projectPath);\n    } catch (e) {\n      error = `Ошибка анализа: ${e}`;\n    }\n    loading = false;\n  }\n\n  // ==================== Сохранение ====================\n\n  async function handleSave() {\n    if (!profile) return;\n    saving = true;\n    error = \"\";\n    savedOk = false;\n    try {\n      await saveProfile(profile);\n      savedOk = true;\n    } catch (e) {\n      error = `Ошибка сохранения: ${e}`;\n    }\n    saving = false;\n  }\n\n  // ==================== Drag