                "text": "use std::process::Child;\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex};\n\n\n#[derive(Debug, Clone)]\npub struct TrackedProcess {\n    pub id: String,\n    pub pid: u32,\n    pub label: String,\n    pub status: ProcessStatus,\n    pub started_at: String, \n}\n\n#[derive(Debug, Clone)] // Позже добавишь Serialize/Deserialize для передачи на фронт\npub enum ProcessStatus {\n    Running,\n    Exited(i32),\n    Killed,\n    Crashed,\n}\n\nstruct ActiveProcess {\n    info: TrackedProcess,\n    child: Option<Child>,\n}\n\nuse std::process::{Command, Stdio};\n\n\npub trait ProcessManager: Send + Sync {\n    fn spawn_and_track(&self, cmd: &str, args: &[&str], working_dir: Option<&str>, label: &str) -> Result<TrackedProcess, String>;\n    // Получить список всех процессов\n    fn list(&self) -> Vec<TrackedProcess>;\n    \n    // Убить процесс по ID\n    fn kill(&self, id: &str) -> Result<(), String>;\n    \n    // Обновить статус конкретного процесса\n    fn refresh_status(&self, id: &str) -> Result<ProcessStatus, String>;\n}\n\npub struct OsProcessManager {\n    // Потокобезопасная таблица: Ключ — ID процесса, Значение — данные + Child\n    processes: Arc<Mutex<HashMap<String, ActiveProcess>>>,\n}\n\nimpl OsProcessManager {\n    // Конструктор для создания монитора при старте приложения\n    pub fn new() -> Self {\n        Self {\n            processes: Arc::new(Mutex::new(HashMap::new())),\n        }\n    }\n}\n\nfn generate_id() -> String {\n    use std::time::{SystemTime, UNIX_EPOCH};\n    let nanos = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_nanos();\n    format!(\"act_{}\", nanos)\n}\nimpl ProcessManager for OsProcessManager {\n    fn spawn_and_track(&self, command: &str, args: &[&str], working_dir: Option<&str>, label: &str) -> Result<TrackedProcess, String> {\n        let mut cmd = Command::new(\"cmd\");\n        cmd.arg(\"/C\").arg(command).args(args)\n            .stdout(Stdio::null())\n            .stderr(Stdio::null());\n        if let Some(dir) = working_dir {\n            cmd.current_dir(dir);\n        }\n\n        let child = cmd.spawn().map_err(|e| format!(\"Ошибка запуска: {}\", e))?;\n        let pid = child.id();\n        let my_id = generate_id();\n        let started_at = chrono::Local::now().format(\"%d.%m.%Y %H:%M:%S\").to_string();\n\n        let info = TrackedProcess {\n            id: my_id.clone(),\n            pid,\n            label: label.to_string(),\n            status: ProcessStatus::Running,\n            started_at,\n        };\n\n        let active_process = ActiveProcess {\n            info: info.clone(),\n            child: Some(child),\n        };\n\n        // Блокируем мутекс, чтобы безопасно вставить данные в HashMap\n        let mut lock = self.processes.lock().unwrap();\n        lock.insert(my_id, active_process);\n\n        Ok(info)\n\n        \n    }\n    fn list(&self) -> Vec<TrackedProcess> {\n        let lock = self.processes.lock().unwrap();\n        let processes = lock.values();\n        let mut process_list: Vec<TrackedProcess> = Vec::new();\n\n        for process in processes {\n            let result = process.info.clone();\n            process_list.push(result);\n        }\n        return process_list;\n    }\n\n    fn kill(&self, id: &str) -> Result<(), String> {\n        let mut lock = self.processes.lock().unwrap();\n        \n        if let Some(process) = lock.get_mut(id) {\n            let pid = process.info.pid;\n            \n            let pid_str = pid.to_string();\n            let _ = Command::new(\"taskkill\")\n                .args([\"/F\", \"/PID\", &pid_str])\n                .status();\n\n            process.child = None;\n            process.info.status = ProcessStatus::Killed;\n            \n            Ok(()) \n        } else {\n            Err(format!(\"Процесс с id {} не найден\", id))\n        }     \n    }\n\n    fn refresh_status(&self, id: &str) -> Result<ProcessStatus, String> {\n        let mut lock = self.processes.lock().unwrap();\n        \n        if let Some(process) = lock.get_mut(id) {\n            if let Some(ref mut child_proc) = process.child {\n                match child_proc.try_wait() {\n                    Ok(None) => {\n                        // Процесс все еще работает!\n                        process.info.status = ProcessStatus::Running;\n                        Ok(ProcessStatus::Running)\n                    }\n                    Ok(Some(status)) => {\n                        process.child = None;\n\n\n                        let exit_code = status.code().unwrap_or(-1);\n                        \n                        let new_status = if status.success() {\n                            ProcessStatus::Exited(exit_code)\n                        } else {\n                            ProcessStatus::Crashed\n                        };\n\n                        process.info.status = new_status.clone();\n                        \n                        Ok(new_status) \n                    }\n                    Err(e) => Err(format!(\"Ошибка ОС при вызове try_wait: {}\", e)),\n                }\n            } else {\n                Ok(process.info.status.clone())\n            }\n        } else {\n            Err(format!(\"Процесс с id {} не найден\", id))\n        }      \n    }\n}    ",
