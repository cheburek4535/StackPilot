              "file": "src-tauri/src/core/models.rs",
              "patch": "Index: src-tauri/src/core/models.rs\n===================================================================\n--- src-tauri/src/core/models.rs\t\n+++ src-tauri/src/core/models.rs\t\n@@ -0,0 +1,40 @@\n+use serde::{Deserialize, Serialize};\n+\n+// ===== AppSettings (глобальные настройки StackPilot) =====\n+\n+#[derive(Debug, Clone, Serialize, Deserialize)]\n+pub struct PreferredApp {\n+    pub name: String,\n+    pub path: String,\n+    pub args: Option<String>,\n+}\n+\n+#[derive(Debug, Clone, Serialize, Deserialize)]\n+pub struct AppSettings {\n+    pub vscode_path: String,\n+    pub browser_path: String,\n+    pub terminal: String,\n+    pub theme: String,\n+    pub language: String,\n+    pub auto_save_profiles: bool,\n+    pub preferred_apps: Vec<PreferredApp>,\n+}\n+\n+// ===== TrackedProcess (процессы, используемые всеми модулями) =====\n+\n+#[derive(Debug, Clone, Serialize, Deserialize)]\n+pub struct TrackedProcess {\n+    pub id: String,\n+    pub pid: u32,\n+    pub label: String,\n+    pub status: ProcessStatus,\n+    pub started_at: String,\n+}\n+\n+#[derive(Debug, Clone, Serialize, Deserialize)]\n+pub enum ProcessStatus {\n+    Running,\n+    Exited(i32),\n+    Killed,\n+    Crashed,\n+}\n",
