ccess_command.spawn() {\n49:                     Ok(_) => {\n50:                             Ok(ActionStatus::Success {\n51:                                 message: format!(\"Команда успешно запущена в фоне: {}\", command),\n52:                             })\n53:                     }\n54:                     Err(err) => {\n55:                         Err(format!(\"Ошибка запуска процесса: {}\", err))\n56:                     }\n57:                 }\n58:             }\n59:             ActionType::OpenUrl { url } => {\n60:                 println!(\"[LaunchEngine] Открыть URL: {:?}\", url);\n61: \n62:                     match webbrowser::open(url) {\n63:                       Ok(_) => {\n64:                         Ok(ActionStatus::Success {\n65:                     message: format!(\"Открыт URL: {}\", url),\n66:                 }) \n67:                     }\n68:                     Err(err) => {\n69:                         Err(format!(\"Ошибка открытия браузера: {}\", err))\n70:                     }\n71:                 }\n72:             }\n73:             ActionType::OpenApplication { path, args } => {\n74:                 println!(\"[LaunchEngine] Запустить: {} {:?}\", path, args);\n75:                 let mut proccess_command = Command::new(path);\n76:                 if let Some(args_str) = args {\n77:                     proccess_command.args(args_str.split_whitespace());\n78:                 }\n79: \n80:                 match proccess_command.spawn() {\n81:                     Ok(_) => {\n82:                             Ok(ActionStatus::Success {\n83:                                 message: format!(\"Приложение успешно запущено в фоне\"),\n84:                             })\n85:                     }\n86:                     Err(err) => {\n87:                         Err(format!(\"Ошибка запуска приложения: {}\", err))\n88:                     }\n89:                 }\n90:             }\n91:             ActionType::WaitForUrl { url, timeout_secs } => {\n92:                 println!(\"[LaunchEngine] Жду URL {} ({}s)\", url, timeout_secs);\n93:                 \n94:                 let pre_formatted_url = url.replace(\"http://\", \"\").replace(\"https://\", \"\");\n95:                 let formatted_url = pre_formatted_url.split('/').next().unwrap_or(pre_formatted_url.as_str());\n96: \n97:                 if let Ok(mut addrs) = formatted_url.to_socket_addrs() {\n98:                     if let Some(addr) = addrs.next() {\n99:                         \n100:                         for _ in 0..*timeout_secs {\n101:                             match TcpStream::connect_timeout(&addr, Duration::from_secs(2)) {\n102:                                 Ok(mut stream) => {\n103:                                     // Исправлено: Строка запроса БЕЗ отступов слева и с макросом format!\n104:                                     let req = format!(\n105: \"GET / HTTP/1.1\\r\n106: Host: {}\\r\n107: Connection: close\\r\n108: \\r\\n\", formatted_url);\n109: \n110:                                     // Отправляем запрос. Если не ушло — игнорируем ошибку и идем на следующий круг\n111:                                     if stream.write_all(req.as_bytes()).is_err() {\n112:                                         thread::sleep(Duration::from_secs(1));\n113:                                         continue;\n114:                                     }\n115: \n116:                                     let mut reader = BufReader::new(&stream);\n117:                                     let mut response_line = String::new();\n118: \n119:                                     // Читаем ответ. Если не прочиталось — на следующий круг\n120:                                     if reader.read_line(&mut response_line).is_err() {\n121:                                         thread::sleep(Duration::from_secs(1));\n122:                                         continue;\n123:                                     }                  \n124:                    