h();\n50:             let filename = path.file_name().and_then(|n| n.to_str()).unwrap_or(\"\");\n51: \n52:             if entry.file_type().is_dir() {\n53:                 if filename == \"node_modules\" || filename == \".git\" || filename == \"target\" || filename == \".venv\" {\n54:                     it.skip_current_dir(); // Говорим walkdir вообще НЕ заходить внутрь этой папки\n55:                     continue;\n56:                 }\n57:             }\n58: \n59:             let current_working_dir = path.parent()\n60:                 .and_then(|p| p.to_str())\n61:                 .unwrap_or(project_path);\n62: \n63:             \n64: \n65:             match filename {\n66:                 \"docker-compose.yml\" | \"docker_compose.yaml\" => {\n67:                     let action = LaunchAction {\n68:                         id: generate_id(),\n69:                         label: \"Запустить Docker\".into(),\n70:                         enabled: true,\n71:                         action_type: ActionType::RunCommand { \n72:                             command: \"docker compose up -d\".into(), \n73:                             working_dir: Some(current_working_dir.to_string()) \n74:                         },\n75:                     };\n76:                     launch_actions.push(action);\n77:                     has_docker = true; // Если докер есть, то на некоторые действия ставится enable = false, но пользователь сможет сменить enable в просмотре профиля\n78:                 }\n79:                 \"package.json\" => {\n80:                     let content = fs::read_to_string(&path).map_err(|e| format!(\"Ошибка чтения: {}\", e))?;\n81:                     let value: serde_json::Value = serde_json::from_str(&content)\n82:                         .map_err(|e| format!(\"Ошибка парсинга package.json: {}\", e))?;\n83: \n84:                     let scripts = value.get(\"scripts\");\n85:                     let dependencies = value.get(\"dependencies\");\n86:                     let dev_dependencies = value.get(\"devDependencies\");\n87: \n88:                     let has_dep = |pkg: &str| {\n89:                         dependencies.and_then(|d| d.get(pkg)).is_some() || \n90:                         dev_dependencies.and_then(|d| d.get(pkg)).is_some()\n91:                     };\n92: \n93:                     let run_command = if has_dep(\"expo\") {\n94:                         // Если это Expo-проект\n95:                         \"npx expo start\".to_string()\n96:                     } else if has_dep(\"@nestjs/core\") {\n97:                         // Если это NestJS\n98:                         scripts.and_then(|s| s.get(\"start:dev\"))\n99:                             .and_then(|c| c.as_str())\n100:                             .unwrap_or(\"npm run start:dev\")\n101:                             .to_string()\n102:                     } else {\n103:                         // Для всех остальных проектов (Next.js, Vite, Nuxt, React)\n104:                         let chosen_script = scripts.and_then(|s| s.get(\"dev\").or_else(|| s.get(\"start\")))\n105:                                                 .and_then(|c| c.as_str())\n106:                                                 .unwrap_or(\"dev\");\n107:                         \n108:                         format!(\"npm run {}\", chosen_script)\n109:                     };\n110: \n111:                     // Создаем действие запуска для этого JS-проекта\n112:                     let js_action = LaunchAction {\n113:                         id: generate_id(),\n114:                         label: format!(\"Запустить Node.js проект ({})\", run_command),\n115:                         enabled: true,\n116:                         action_type: ActionType::RunCommand {\n117:                             command: run_command,\n118:                             working_dir: Some(current_working_dir.to_string()),\n119:                         },\n120:                     };\n121:              