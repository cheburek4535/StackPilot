        "dart" => {
            // Dart-пакеты не принимают дефис в имени — приводим к подчёркиванию
            let safe_name = project_name.replace('-', "_");
            vec![
                cmd("dart_create", "Create Dart project",
                    &format!("Create new Dart project '{}'", project_name),
