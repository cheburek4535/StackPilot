or: #666;\n+  }\n+\n+  .field input,\n+  .field select,\n+  .field textarea {\n+    padding: 0.4rem 0.6rem;\n+    border: 1px solid #d0d0d0;\n+    border-radius: 6px;\n+    font-size: 0.85rem;\n+    background: #fff;\n+    transition: border-color 0.15s;\n+    font-family: inherit;\n+  }\n+\n+  .field input:focus,\n+  .field select:focus,\n+  .field textarea:focus {\n+    outline: none;\n+    border-color: #396cd8;\n+  }\n+\n+  .field textarea {\n+    min-height: 3rem;\n+    resize: vertical;\n+    font-family: \"Cascadia Code\", \"Fira Code\", monospace;\n+  }\n+\n+  .add-wrapper {\n+    position: relative;\n+    margin-top: 0.75rem;\n+  }\n+\n+  .add-btn {\n+    width: 100%;\n+    padding: 0.7rem;\n+    border: 2px dashed #ccc;\n+    border-radius: 10px;\n+    background: transparent;\n+    color: #888;\n+    font-size: 0.9rem;\n+    cursor: pointer;\n+    transition: all 0.15s;\n+  }\n+\n+  .add-btn:hover {\n+    border-color: #396cd8;\n+    color: #396cd8;\n+    background: #f0f4ff;\n+  }\n+\n+  .add-menu {\n+    position: absolute;\n+    top: calc(100% + 4px);\n+    left: 0;\n+    right: 0;\n+    background: #fff;\n+    border: 1px solid #e0e0e0;\n+    border-radius: 10px;\n+    box-shadow: 0 4px 16px rgba(0,0,0,0.12);\n+    z-index: 50;\n+    overflow: hidden;\n+  }\n+\n+  .add-menu-item {\n+    display: flex;\n+    align-items: center;\n+    gap: 0.6rem;\n+    width: 100%;\n+    padding: 0.6rem 0.8rem;\n+    border: none;\n+    background: transparent;\n+    text-align: left;\n+    cursor: pointer;\n+    font-size: 0.85rem;\n+    transition: background 0.1s;\n+  }\n+\n+  .add-menu-item:hover { background: #f5f5ff; }\n+\n+  .add-icon { font-size: 1.1rem; }\n+\n+  .add-menu-item div { display: flex; flex-direction: column; }\n+\n+  .add-menu-item strong { font-weight: 600; font-size: 0.9rem; }\n+\n+  .add-desc { font-size: 0.75rem; color: #999; }\n+\n+  .footer-save {\n+    margin-top: 1.5rem;\n+    text-align: center;\n+  }\n+\n+  button.primary {\n+    padding: 0.5rem 1.2rem;\n+    border-radius: 8px;\n+    border: none;\n+    background: #396cd8;\n+    color: #fff;\n+    font-size: 0.9rem;\n+    font-weight: 600;\n+    cursor: pointer;\n+    transition: background 0.15s;\n+  }\n+  button.primary:hover:not(:disabled) { background: #2b5ab0; }\n+  button.primary:disabled { opacity: 0.5; cursor: not-allowed; }\n+\n+  button.secondary {\n+    padding: 0.5rem 1.2rem;\n+    border-radius: 8px;\n+    border: 1px solid #ccc;\n+    background: #fff;\n+    color: #444;\n+    font-size: 0.9rem;\n+    cursor: pointer;\n+    transition: background 0.15s;\n+  }\n+  button.secondary:hover:not(:disabled) { background: #f0f0f0; }\n+  button.secondary:disabled { opacity: 0.5; cursor: not-allowed; }\n+\n+  @media (prefers-color-scheme: dark) {\n+    :root { color: #f6f6f6; background-color: #2f2f2f; }\n+\n+    .picker-card { background: #0f0f0f98; border-color: #444; }\n+    .path-display { background: #2a2a2a; color: #ccc; }\n+\n+    .action-card { background: #0f0f0f98; border-color: #444; }\n+    .card-editor { background: #1a1a1a; border-top-color: #444; }\n+    .field label { color: #aaa; }\n+    .field input, .field select, .field textarea { background: #2a2a2a; border-color: #555; color: #eee; }\n+    .field input:focus, .field select:focus, .field textarea:focus { border-color: #5b8def; }\n+\n+    .toggle-btn { background: #2a2a2a; border-color: #555; color: #888; }\n+    .toggle-btn.on { background: #1b3a1b; border-color: #2e7d32; color: #81c784; }\n+\n+    .icon-btn { border-color: #444; color: #888; }\n+    .icon-btn:hover { background: #333; color: #eee; }\n+\n+    .add-btn { border-color: #555; color: #888; }\n+    .add-btn:hover { border-color: #5b8def; color: #5b8def; background: #1a1a3e; }\n+\n+    .add-menu { background: #1e1e1e; border-color: #444; }\n+    .add-menu-item:hover { background: #2a2a3e; }\n+\n+    button.secondary { background: #2a2a2a; color: #ccc; border-color: #555; }\n+    button.secondary:hover:not(:disabled) { background: #333; }\n+  }\n+</style>\n",
