              "content": "// ============================================================\n// LaunchEngine — движок запуска профилей.\n//\n// LaunchEngine выполняет действия из LaunchProfile одно за другим.\n// Он НЕ анализирует проекты — только исполняет.\n//\n// В этой версии — заглушка. Команды просто логируются.\n// Полноценная реализация будет позже и будет:\n//   • запускать процессы в терминале\n//   • открывать URL и приложения\n//   • ждать порты/URL\n//   • обрабатывать ошибки и таймауты\n// ============================================================\n\nuse crate::models::*;\n\n// --------------------------------------------------\n// Трейт LaunchEngine\n// --------------------------------------------------\npub trait LaunchEngine: Send + Sync {\n    /// Выполнить одно действие и вернуть результат\n    fn execute_action(&self, action: &LaunchAction) -> Result<ActionStatus, String>;\n}\n\n// --------------------------------------------------\n// SimpleLaunchEngine — заглушка\n//\n// Пока просто пишет в консоль и возвращает Success.\n// Это позволяет разрабатывать UI до реализации движка.\n// --------------------------------------------------\npub struct SimpleLaunchEngine;\n\nimpl LaunchEngine for SimpleLaunchEngine {\n    fn execute_action(&self, action: &LaunchAction) -> Result<ActionStatus, String> {\n        // Если действие выключено — пропускаем\n        if !action.enabled {\n            return Ok(ActionStatus::Skipped {\n                reason: format!(\"Действие '{}' отключено\", action.label),\n            });\n        }\n\n        // Логируем и возвращаем заглушку\n        match &action.action_type {\n            ActionType::RunCommand { command, working_dir } => {\n                println!(\n                    \"[LaunchEngine] Команда: '{}' в папке {:?}\",\n                    command, working_dir\n                );\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Команда запущена: {}\", command),\n                })\n            }\n            ActionType::OpenUrl { url } => {\n                println!(\"[LaunchEngine] Открыть URL: {}\", url);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Открыт URL: {}\", url),\n                })\n            }\n            ActionType::OpenApplication { path, args } => {\n                println!(\"[LaunchEngine] Запустить: {} {:?}\", path, args);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Запущено: {}\", path),\n                })\n            }\n            ActionType::WaitForUrl { url, timeout_secs } => {\n                println!(\"[LaunchEngine] Жду URL {} ({}s)\", url, timeout_secs);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] URL доступен: {}\", url),\n                })\n            }\n            ActionType::WaitForPort { host, port, timeout_secs } => {\n                println!(\"[LaunchEngine] Жду порт {}:{} ({}s)\", host, port, timeout_secs);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Порт доступен: {}:{}\", host, port),\n                })\n            }\n            ActionType::Delay { seconds } => {\n                println!(\"[LaunchEngine] Пауза {}s\", seconds);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Пауза {} секунд\", seconds),\n                })\n            }\n            ActionType::ExecuteScript { script, shell } => {\n                println!(\"[LaunchEngine] Скрипт: '{}' через {:?}\", script, shell);\n                Ok(ActionStatus::Success {\n                    message: format!(\"[Заглушка] Скрипт выполнен: {}\", script),\n                })\n            }\n        }\n    }\n}\n"
            },
